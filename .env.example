# Neon Postgres (Vercel > Settings > Environment Variables)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# รหัสเข้าหน้า /admin (ตั้งค่าใน Vercel > Environment Variables ด้วย)
ADMIN_PASSWORD="ตั้งรหัสของคุณเอง"

# คีย์เซ็น cookie ของ admin (ถ้าไม่ตั้ง ระบบจะสร้างจาก ADMIN_PASSWORD + DATABASE_URL ให้)
ADMIN_SESSION_SECRET=""

# ปลายทาง API สร้างภาพ (ค่าเริ่มต้นใช้ได้เลย)
OVERCHAT_API_BASE="https://api.overchat.ai"